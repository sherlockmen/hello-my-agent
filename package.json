{
  "name": "@sherlockmen/hello-my-agent",
  "version": "0.1.0-dev.1",
  "private": true,
  "description": "Hello, My Agent：从 0 到 npm 发布，亲手构建你的 TUI Coding Agent",
  "license": "MIT",
  "type": "module",
  "bin": {
    "hello-my-agent": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "chapter:01": "tsx chapter-01-first-command/cli.ts",
    "exercise:01": "tsx chapter-01-first-command/cli-with-doctor.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "verify": "npm run typecheck && npm run build && node tests/verify-install.mjs"
  },
  "dependencies": {
    "commander": "14.0.3"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sherlockmen/hello-my-agent.git"
  }
}
