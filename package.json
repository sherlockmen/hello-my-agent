{
  "name": "@sherlockmen/hello-my-agent",
  "version": "0.1.0-dev.1",
  "private": true,
  "description": "Hello, My Agent：从 0 到 npm 发布，亲手构建你的 TUI Coding Agent",
  "license": "MIT",
  "type": "module",
  "bin": {
    "hello-my-agent": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node scripts/compile.mjs 02.1 --prepare",
    "lesson:01": "node scripts/compile.mjs 01 --prepare --run",
    "lesson:02.1": "node scripts/compile.mjs 02.1 --prepare --run",
    "lesson:02.2": "node scripts/compile.mjs 02.2 --prepare --run",
    "lesson:02.3": "node scripts/compile.mjs 02.3 --prepare --run",
    "lesson:02.4": "node scripts/compile.mjs 02.4 --prepare --run",
    "lesson:02.5": "node scripts/compile.mjs 02.5 --prepare --run",
    "lesson:02.6": "node scripts/compile.mjs 02.6 --prepare --run",
    "check:02.3": "node tests/verify-install.mjs 3",
    "check:02.4": "node tests/verify-install.mjs 4",
    "typecheck": "tsc --noEmit",
    "prepack": "node scripts/compile.mjs 02.1",
    "verify": "npm run typecheck && node scripts/compile.mjs && node tests/verify-install.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.126.0",
    "commander": "14.0.3",
    "openai": "7.15.0"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sherlockmen/hello-my-agent.git"
  }
}
