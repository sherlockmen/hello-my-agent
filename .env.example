# 第 02 章：复制为运行目录下的 .env，只填写准备使用的那组配置。
# 不要提交真实密钥。两组配置相互独立，切换协议不会复用另一组密钥。
AGENT_PROVIDER=openai

# OpenAI 兼容 Chat Completions：填写实际服务商的密钥、模型 ID 与基础地址。
OPENAI_API_KEY=
OPENAI_MODEL=
# 留空使用 https://api.openai.com/v1，不要填完整的 /chat/completions 路径。
OPENAI_BASE_URL=

# Anthropic Messages：可以与上面一组同时配置，通过 --provider anthropic 选择。
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# 留空使用 https://api.anthropic.com，不要填完整的 /v1/messages 路径。
ANTHROPIC_BASE_URL=

# 第 15 章：本地预算示例，按实际服务商文档设置；程序不会自动查询模型窗口。
# 未设置时使用本教程的本地示例预算 32768 / 2048，不代表服务商承诺的窗口。
# AGENT_CONTEXT_WINDOW=32768
# AGENT_OUTPUT_RESERVE=2048
# 可选：每百万 token 的美元单价。缺少价格或服务端 usage 时不生成费用估计。
# AGENT_INPUT_PRICE_PER_MILLION=
# AGENT_OUTPUT_PRICE_PER_MILLION=
